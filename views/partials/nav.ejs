<nav class="navbar">
  <div class="nav-container">
    <a href="/listings" class="nav-logo">🔄 SwapShop</a>
    <div class="nav-links">
      <a href="/listings">Browse</a>
      <% if (user) { %>
        <a href="/listings/new" class="btn btn-primary btn-sm">+ Post Item</a>
        <a href="/messages/inbox">Inbox</a>
        <div class="nav-user">
          <span>
            <% if (user.profileImage) { %>
              <img src="<%= user.profileImage %>" alt="" style="width:24px;height:24px;border-radius:50%;vertical-align:middle;" />
            <% } else { %>👤<% } %>
            <%= user.username %>
          </span>
          <form method="POST" action="/logout" style="display:inline">
            <button type="submit" class="btn-link">Log out</button>
          </form>
        </div>
      <% } else { %>
        <a href="<%= loginUrl %>" class="btn btn-primary btn-sm">Log in with Replit</a>
      <% } %>
    </div>
  </div>
</nav>
