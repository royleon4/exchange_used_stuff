<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Listing — SwapShop</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="form-page">
      <h1>Edit Listing</h1>
      <form method="POST" action="/listings/<%= listing._id %>/edit" enctype="multipart/form-data" class="form">
        <div class="form-row">
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required value="<%= listing.title %>" maxlength="100" />
          </div>
          <div class="form-group">
            <label for="type">Listing Type</label>
            <select id="type" name="type" required onchange="togglePrice(this.value)">
              <option value="give_away" <%= listing.type === 'give_away' ? 'selected' : '' %>>Free / Give Away</option>
              <option value="sell" <%= listing.type === 'sell' ? 'selected' : '' %>>For Sale</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group" id="price-group" style="display:<%= listing.type === 'sell' ? 'block' : 'none' %>">
            <label for="price">Price ($)</label>
            <input type="number" id="price" name="price" min="0" step="0.01" value="<%= listing.price %>" />
          </div>
          <div class="form-group">
            <label for="category">Category</label>
            <select id="category" name="category">
              <% ['Other','Electronics','Furniture','Clothing','Books','Sports','Toys','Kitchen','Tools','Garden','Vehicles'].forEach(cat => { %>
                <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" required rows="4"><%= listing.description %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= listing.location %>" />
          </div>
          <div class="form-group">
            <label for="image">Replace Photo</label>
            <input type="file" id="image" name="image" accept="image/*" />
            <% if (listing.imageUrl) { %>
              <small>Current photo: <a href="<%= listing.imageUrl %>" target="_blank">view</a></small>
            <% } %>
          </div>
        </div>

        <div class="form-actions">
          <a href="/listings/<%= listing._id %>" class="btn btn-ghost">Cancel</a>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </main>
  <footer class="footer"><p>SwapShop &mdash; Give, sell, and find used treasures in your community.</p></footer>
  <script>
    function togglePrice(val) {
      document.getElementById('price-group').style.display = val === 'sell' ? 'block' : 'none';
    }
  </script>
</body>
</html>
