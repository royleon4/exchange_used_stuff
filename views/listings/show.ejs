<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= listing.title %> — SwapShop</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="main-content">
    <%- include('../partials/flash') %>

    <div class="show-container">
      <a href="/listings" class="back-link">← Back to listings</a>

      <div class="show-grid">
        <div class="show-image-col">
          <% if (listing.imageUrl) { %>
            <img src="<%= listing.imageUrl %>" alt="<%= listing.title %>" class="show-image" />
          <% } else { %>
            <div class="show-no-image">📷<br>No photo</div>
          <% } %>
        </div>

        <div class="show-details">
          <div class="show-header">
            <span class="listing-badge <%= listing.type === 'give_away' ? 'badge-free' : 'badge-sale' %> badge-lg">
              <%= listing.type === 'give_away' ? '🎁 Free' : '💰 $' + listing.price.toFixed(2) %>
            </span>
            <span class="show-category"><%= listing.category %></span>
          </div>

          <h1 class="show-title"><%= listing.title %></h1>

          <div class="show-meta">
            <span>Posted by <strong><%= listing.ownerName %></strong></span>
            <span><%= new Date(listing.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            <% if (listing.location) { %><span>📍 <%= listing.location %></span><% } %>
          </div>

          <div class="show-description">
            <h2>Description</h2>
            <p><%= listing.description %></p>
          </div>

          <% if (user && user._id === listing.userId) { %>
            <div class="owner-actions">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-secondary">✏ Edit Listing</a>
              <form method="POST" action="/listings/<%= listing._id %>/delete" onsubmit="return confirm('Delete this listing?')">
                <button type="submit" class="btn btn-danger">🗑 Delete</button>
              </form>
            </div>
          <% } else if (user) { %>
            <div class="contact-box">
              <h2>Contact the <%= listing.type === 'give_away' ? 'giver' : 'seller' %></h2>
              <form method="POST" action="/messages" class="form">
                <input type="hidden" name="listingId" value="<%= listing._id %>" />
                <div class="form-group">
                  <textarea name="content" rows="3" placeholder="Hi! I'm interested in your <%= listing.title %>…" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
              </form>
            </div>
          <% } else { %>
            <div class="contact-box contact-box-guest">
              <p><a href="/login">Log in</a> or <a href="/signup">sign up</a> to contact the <%= listing.type === 'give_away' ? 'giver' : 'seller' %>.</p>
            </div>
          <% } %>
        </div>
      </div>

      <% if (user && user._id === listing.userId && messages.length > 0) { %>
        <div class="messages-section">
          <h2>Messages about this listing (<%= messages.length %>)</h2>
          <div class="messages-list">
            <% messages.forEach(msg => { %>
              <div class="message-item">
                <div class="message-header">
                  <strong><%= msg.senderName %></strong>
                  <span><%= new Date(msg.createdAt).toLocaleString() %></span>
                </div>
                <p class="message-content"><%= msg.content %></p>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </main>
  <footer class="footer"><p>SwapShop &mdash; Give, sell, and find used treasures in your community.</p></footer>
</body>
</html>
