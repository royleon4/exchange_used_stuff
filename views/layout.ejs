<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>SwapShop</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <a href="/listings" class="nav-logo">🔄 SwapShop</a>
      <div class="nav-links">
        <a href="/listings">Browse</a>
        <% if (user) { %>
          <a href="/listings/new" class="btn btn-primary btn-sm">+ Post Item</a>
          <a href="/messages/inbox">Inbox</a>
          <div class="nav-user">
            <span>👤 <%= user.username %></span>
            <form method="POST" action="/logout" style="display:inline">
              <button type="submit" class="btn-link">Log out</button>
            </form>
          </div>
        <% } else { %>
          <a href="<%= loginUrl %>" class="btn btn-primary btn-sm">Log in with Replit</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="main-content">
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>
    <%- body %>
  </main>

  <footer class="footer">
    <p>SwapShop &mdash; Give, sell, and find used treasures in your community.</p>
  </footer>
</body>
</html>
